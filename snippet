const LOGO_SPX_INBOUND_B64 = 'data:image/png;base64,';

const LOGO_ESP_B64 = 'data:image/png;base64,';

async function exportExcelBerat(){

if(scannedBarcodes.length === 0){
    alert("BELUM ADA DATA");
    return;
}

// INBOUND BERAT -> EXCEL SAJA.
// Layout dibuat mengikuti hasil laporan cetak: kop/logo, keterangan,
// tabel 2 sisi, total dengan RUMUS Excel, tanda tangan kiri/kanan,
// dan page break otomatis setiap 70 kantong agar data tidak terpotong.
const tanggal  = document.getElementById("tanggal")?.value || "";
const penerima = document.getElementById("penerima")?.value || "";
const penyerah = document.getElementById("penyerah")?.value || "";
const nomor    = generateNomorDokumen();
nomorInboundBeratTerakhir = nomor;

if(typeof ExcelJS === "undefined"){
    alert("Komponen Excel belum tersedia. Pastikan koneksi internet aktif lalu coba lagi.");
    return;
}

try{
    const wb = new ExcelJS.Workbook();
    wb.creator = "INBOUND BERAT";
    wb.created = new Date();
    // Pastikan Excel menghitung ulang semua rumus saat file dibuka/diedit.
    wb.calcProperties = { calcMode: "auto", fullCalcOnLoad: true, forceFullCalc: true };

    const ws = wb.addWorksheet("INBOUND BERAT", {
        views: [{showGridLines:false}]
    });

    // Lebar kolom mengikuti tabel laporan cetak.
    ws.columns = [
        {width: 7}, {width: 24}, {width: 16},
        {width: 7}, {width: 24}, {width: 16}
    ];

    const thinBorder = {
        top:{style:"thin"}, bottom:{style:"thin"},
        left:{style:"thin"}, right:{style:"thin"}
    };
    const mediumBorder = {
        top:{style:"medium"}, bottom:{style:"medium"},
        left:{style:"thin"}, right:{style:"thin"}
    };

    // =========================
    // KOP SURAT + LOGO
    // =========================
    // Dibuat seperti hasil print: logo kiri, teks kop di tengah, logo kanan.
    ws.getRow(1).height = 34;
    ws.getRow(2).height = 6;
    ws.getRow(3).height = 6;

    ws.mergeCells("B1:E1");
    ws.getCell("B1").value = "SERAH TERIMA KONTONG RETUR ESP ➜ POSIND";
    ws.getCell("B1").font = {bold:true,size:16};
    ws.getCell("B1").alignment = {horizontal:"center",vertical:"middle"};

    ws.mergeCells("B2:E2");
    ws.getCell("B2").value = "";
    ws.getCell("B2").font = {bold:true,size:11};
    ws.getCell("B2").alignment = {horizontal:"center",vertical:"middle"};
    for(let c=1;c<=6;c++) ws.getCell(3,c).border = {bottom:{style:"medium"}};

    ws.mergeCells("A5:F5");
    ws.getCell("A5").value = "";
    ws.getCell("A5").font = {bold:true,size:16};
    ws.getCell("A5").alignment = {horizontal:"center",vertical:"middle"};

    ws.mergeCells("A6:F6");
    ws.getCell("A6").value = "";
    ws.getCell("A6").font = {bold:true,size:11};
    ws.getCell("A6").alignment = {horizontal:"center",vertical:"middle"};

    // =========================
    // INFORMASI DOKUMEN
    // =========================
    const info = [
        ["Nomor Dokumen", nomor],
        ["Tanggal", tanggal],
        ["Nama Penerima", penerima],
        ["Nama Penyerah", penyerah]
    ];
    info.forEach((x,i)=>{
        const r=8+i;
        ws.mergeCells(r,1,r,2);
        ws.getCell(r,1).value=x[0];
        ws.getCell(r,1).font={bold:true,size:10};
        ws.getCell(r,1).alignment={horizontal:"left",vertical:"middle"};
        ws.mergeCells(r,3,r,6);
        ws.getCell(r,3).value=": " + x[1];
        ws.getCell(r,3).font={size:10};
        ws.getCell(r,3).alignment={horizontal:"left",vertical:"middle"};
        ws.getRow(r).height=18;
    });

    const headerRow = 13;
    const perColumn = 35;
    const perPage = 70;
    const totalPages = Math.ceil(scannedBarcodes.length / perPage);

    // Header tabel halaman pertama.
    function writeTableHeader(row){
        const headers=["NO","KANTONG","BERAT (KG)","NO","KANTONG","BERAT (KG)"];
        headers.forEach((v,c)=>{
            const cell=ws.getCell(row,c+1);
            cell.value=v;
            cell.font={bold:true,color:{argb:"FFFFFFFF"},size:10};
            cell.fill={type:"pattern",pattern:"solid",fgColor:{argb:"FF000000"}};
            cell.alignment={horizontal:"center",vertical:"middle"};
            cell.border=thinBorder;
        });
        ws.getRow(row).height=20;
    }

    // =========================
    // FUNGSI LOGO
    // =========================
    async function addEmbeddedImage(dataUri, tl, br){
        try{
            const base64 = dataUri.split(",")[1];
            const id = wb.addImage({base64, extension:"png"});
            ws.addImage(id,{tl,br});
            return true;
        }catch(e){
            console.warn("Logo Excel tidak dapat ditambahkan:", e);
            return false;
        }
    }

    // =========================
    // UKURAN LOGO (mudah diedit)
    // Ubah nilai COL/WIDTH/HEIGHT di sini bila ingin logo lebih besar/kecil.
    // =========================
    const LOGO_SPX_WIDTH  = 0.95;
    const LOGO_SPX_HEIGHT = 2.35;
    const LOGO_ESP_WIDTH  = 0.95;
    const LOGO_ESP_HEIGHT = 2.35;

    // Logo di-embed langsung ke workbook agar selalu muncul saat file XLSX dibuka.
    await addEmbeddedImage(LOGO_SPX_INBOUND_B64, {col:0.08,row:0.05}, {col:0.08+LOGO_SPX_WIDTH,row:0.05+LOGO_SPX_HEIGHT});
    await addEmbeddedImage(LOGO_ESP_B64,         {col:5.02,row:0.05}, {col:5.02+LOGO_ESP_WIDTH,row:0.05+LOGO_ESP_HEIGHT});

    // =========================
    // DATA: SEMUA BARIS MASUK
    // =========================
    // Data 1-35 di kiri, 36-70 di kanan.
    // Jika lebih dari 70, halaman berikutnya dibuat di bawah dan diberi page break.
    let currentRow = headerRow;
    const allWeightCells = [];
    const allBagCells = [];
    const pageEndRows = [];

    for(let page=0; page<totalPages; page++){
        const pageStartIndex = page * perPage;
        const pageData = scannedBarcodes.slice(pageStartIndex, pageStartIndex + perPage);

        // Untuk halaman berikutnya beri jarak kecil dari halaman sebelumnya.
        if(page > 0){
            currentRow += 3;
            // Judul kecil agar setiap halaman tetap jelas saat dicetak.
            ws.mergeCells(currentRow,1,currentRow,6);
            ws.getCell(currentRow,1).value = "LAPORAN INBOUND BERAT — LANJUTAN";
            ws.getCell(currentRow,1).font = {bold:true,size:12};
            ws.getCell(currentRow,1).alignment = {horizontal:"center",vertical:"middle"};
            ws.getRow(currentRow).height = 22;
            currentRow++;
        }

        const pageHeader = currentRow;
        writeTableHeader(pageHeader);
        currentRow++;

        const pageFirstDataRow = currentRow;
        for(let i=0;i<perColumn;i++){
            const leftIndex = i;
            const rightIndex = i + perColumn;
            const leftGlobal = pageStartIndex + leftIndex;
            const rightGlobal = pageStartIndex + rightIndex;

            const entries = [
                leftGlobal < scannedBarcodes.length && leftIndex < pageData.length ? scannedBarcodes[leftGlobal] : "",
                rightGlobal < scannedBarcodes.length && rightIndex < pageData.length ? scannedBarcodes[rightGlobal] : ""
            ];

            const r = currentRow + i;
            const leftBarcode = entries[0];
            const rightBarcode = entries[1];
            const leftWeight = leftBarcode !== "" ? (parseFloat(dataBerat[leftBarcode]) || 0) : "";
            const rightWeight = rightBarcode !== "" ? (parseFloat(dataBerat[rightBarcode]) || 0) : "";
            const vals = [
                leftBarcode!=="" ? String(leftGlobal+1) : "",
                leftBarcode,
                leftWeight,
                rightBarcode!=="" ? String(rightGlobal+1) : "",
                rightBarcode,
                rightWeight
            ];

            vals.forEach((v,c)=>{
                const cell=ws.getCell(r,c+1);
                cell.value=(c===0 || c===3) && v!=="" ? String(v) : v;
                cell.border=thinBorder;
                cell.alignment={horizontal:(c===2||c===5)?"center":"center",vertical:"middle"};
                cell.font={size:9};
                // NO = bilangan bulat tanpa koma/desimal. BERAT = 2 angka desimal.
                if(c===0||c===3){
                    cell.numFmt='0';
                }
                if(c===2||c===5){
                    cell.numFmt='#,##0.00';
                }
            });
            ws.getRow(r).height=17;

            if(leftBarcode!==""){
                allBagCells.push(`B${r}`);
                allWeightCells.push(`C${r}`);
            }
            if(rightBarcode!==""){
                allBagCells.push(`E${r}`);
                allWeightCells.push(`F${r}`);
            }
        }

        currentRow = pageFirstDataRow + perColumn - 1;
        pageEndRows.push(currentRow);

        // Bila masih ada halaman data, beri page break setelah blok 70 data.
        if(page < totalPages-1){
            ws.getRow(currentRow).addPageBreak();
        }
    }

    // =========================
    // RINGKASAN TOTAL DENGAN RUMUS EXCEL
    // =========================
    // Rumus menggunakan semua sel data, sehingga nilainya otomatis berubah
    // bila angka berat di Excel diedit.
    const summaryRow = currentRow + 2;
    ws.mergeCells(summaryRow,1,summaryRow,3);
    ws.mergeCells(summaryRow,4,summaryRow,6);
    ws.getCell(summaryRow,1).value="JUMLAH KANTONG";
    ws.getCell(summaryRow,4).value="JUMLAH BERAT";
    ws.getCell(summaryRow,1).font={bold:true,size:12};
    ws.getCell(summaryRow,4).font={bold:true,size:12};
    ws.getCell(summaryRow,1).alignment={horizontal:"center",vertical:"middle"};
    ws.getCell(summaryRow,4).alignment={horizontal:"center",vertical:"middle"};
    for(let c=1;c<=6;c++) ws.getCell(summaryRow,c).border=mediumBorder;
    ws.getRow(summaryRow).height=22;

    const countFormula = allBagCells.length ? `COUNTA(${allBagCells.join(",")})` : "0";
    const sumFormula = allWeightCells.length ? `SUM(${allWeightCells.join(",")})` : "0";
    // Nilai awal rumus dihitung dari data saat ini. Setelah dibuka di Excel,
    // formula tetap aktif dan akan menghitung ulang bila berat diedit.
    const totalBeratExcel = scannedBarcodes.reduce((sum, barcode) => {
        const raw = dataBerat[barcode];
        const n = parseFloat(String(raw ?? "").replace(/[^0-9,.-]/g, "").replace(/,(?=[0-9]{1,2}$)/, "."));
        return sum + (Number.isFinite(n) ? n : 0);
    }, 0);

    ws.mergeCells(summaryRow+1,1,summaryRow+1,3);
    ws.mergeCells(summaryRow+1,4,summaryRow+1,6);
    ws.getCell(summaryRow+1,1).value={formula:countFormula, result:scannedBarcodes.length};
    ws.getCell(summaryRow+1,4).value={formula:sumFormula, result:totalBeratExcel};
    ws.getCell(summaryRow+1,1).numFmt='0 "KANTONG"';
    ws.getCell(summaryRow+1,4).numFmt='#,##0.00 "KG"';
    ws.getCell(summaryRow+1,1).font={bold:true,size:15};
    ws.getCell(summaryRow+1,4).font={bold:true,size:15};
    ws.getCell(summaryRow+1,1).alignment={horizontal:"center",vertical:"middle"};
    ws.getCell(summaryRow+1,4).alignment={horizontal:"center",vertical:"middle"};
    for(let c=1;c<=6;c++) ws.getCell(summaryRow+1,c).border=mediumBorder;
    ws.getRow(summaryRow+1).height=28;

    // =========================
    // TANDA TANGAN: KIRI & KANAN
    // =========================
    const signRow = summaryRow + 4;
    ws.mergeCells(signRow,1,signRow,3);
    ws.mergeCells(signRow,4,signRow,6);
    ws.getCell(signRow,1).value="Penerima";
    ws.getCell(signRow,4).value="Penyerah";
    ws.getCell(signRow,1).alignment={horizontal:"center",vertical:"middle"};
    ws.getCell(signRow,4).alignment={horizontal:"center",vertical:"middle"};
    ws.getCell(signRow,1).font={size:11};
    ws.getCell(signRow,4).font={size:11};

    // Ruang tanda tangan cukup tinggi.
    ws.getRow(signRow+1).height=18;
    ws.getRow(signRow+2).height=18;
    ws.getRow(signRow+3).height=18;
    ws.mergeCells(signRow+3,1,signRow+3,3);
    ws.mergeCells(signRow+3,4,signRow+3,6);
    ws.getCell(signRow+3,1).value="("+penerima+")";
    ws.getCell(signRow+3,4).value="("+penyerah+")";
    ws.getCell(signRow+3,1).alignment={horizontal:"center",vertical:"middle"};
    ws.getCell(signRow+3,4).alignment={horizontal:"center",vertical:"middle"};
    ws.getCell(signRow+3,1).font={size:11};
    ws.getCell(signRow+3,4).font={size:11};

    // Tidak ada garis tanda tangan; label dan nama tetap dipertahankan.

    // =========================
    // PENGATURAN CETAK EXCEL
    // =========================
    ws.pageSetup = {
        paperSize: 9,
        orientation: "portrait",
        fitToPage: true,
        fitToWidth: 1,
        fitToHeight: 0,
        horizontalDpi: 300,
        verticalDpi: 300
    };
    ws.pageSetup.margins={left:0.25,right:0.25,top:0.35,bottom:0.35,header:0.1,footer:0.1};
    ws.pageSetup.printArea=`A1:F${signRow+3}`;
    ws.views=[{showGridLines:false}];
    ws.freezePanes={xSplit:0,ySplit:headerRow};

    const buffer=await wb.xlsx.writeBuffer();
    const blob=new Blob([buffer],{type:"application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"});
    const a=document.createElement("a");
    a.href=URL.createObjectURL(blob);
